# Copia este archivo a .env y llena los valores reales.
# NUNCA subas .env a git -- .gitignore ya lo excluye.

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* -- para "npm run build" (Next las incrusta en el bundle que
# llega al navegador; se configuran en Cloudflare Pages -> Settings ->
# Environment variables, en la sección de build, no en la de Functions).
# Ninguna es secreta: si lo fuera, no llevaría este prefijo.
# ---------------------------------------------------------------------------

# PENDIENTE: subdominio real de esta portada.
NEXT_PUBLIC_SITE_URL=https://demo.aplicacionesrd.com

# PENDIENTE: WhatsApp de la administración, formato internacional sin signos.
NEXT_PUBLIC_WHATSAPP=

# PENDIENTE: sitekey de Turnstile (Cloudflare -> Turnstile -> Add site).
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# PENDIENTE: ID de medición de GA4 ("G-XXXXXXXXXX").
NEXT_PUBLIC_GA_ID=

# PENDIENTE: ID del píxel de Meta.
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Secretos de Cloudflare Pages Functions, NO de Next -- se configuran en el
# panel de Cloudflare (Settings -> Environment variables, sección Functions)
# o con `wrangler secret put`, nunca en un archivo que llegue a git.
# ---------------------------------------------------------------------------

# PENDIENTE: la base de Airtable todavía no existe. Ver README.md -> "Antes
# de publicar" para el nombre exacto de columnas que espera la Function.
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Solicitudes
AIRTABLE_API_KEY=

# PENDIENTE: secreto de Turnstile, pareja de NEXT_PUBLIC_TURNSTILE_SITEKEY.
TURNSTILE_SECRET_KEY=
