# Copia este archivo a .env y llena los valores reales.
# NUNCA subas .env a git -- .gitignore ya lo excluye.
#
# Estas dos son secretos de Cloudflare Pages Functions, no de Next: se
# configuran en el panel de Cloudflare (Settings -> Environment variables)
# o con `wrangler secret put`, nunca en el bundle que llega al navegador.

# Base de Airtable donde caen las solicitudes de demo.
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Solicitudes
AIRTABLE_API_KEY=

# Clave secreta de Cloudflare Turnstile (anti-bots). La clave PUBLICA del
# widget va aparte, en contenido/sitio.ts, porque esa sí es de uso público.
TURNSTILE_SECRET_KEY=
