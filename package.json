{
  "name": "condoapp-landing",
  "private": true,
  "version": "0.1.0",
  "description": "Landing page de captación de CondoApp. Sitio estático, sin servidor propio: la única pieza dinámica es una Cloudflare Pages Function que recibe el formulario de demo.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "tipos": "tsc --noEmit",
    "pruebas": "vitest run",
    "pruebas:watch": "vitest",
    "build:e2e": "cross-env NEXT_PUBLIC_SITE_URL=http://127.0.0.1:8788 NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA next build",
    "pruebas:e2e": "playwright test",
    "pruebas:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "cross-env": "10.1.0",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true,
    "unrs-resolver@1.12.2": true
  }
}
